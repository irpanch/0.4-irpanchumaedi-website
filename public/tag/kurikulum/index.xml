    <item>
      <title>Filosofi: Pengguna vs. Pembuat Kode</title>
      <link>https://irpanblog2.netlify.app/post/materi-pengguna-pembuat-kode/</link>
      <pubDate>Sun, 17 May 2026 00:00:00 +0000</pubDate>
      <guid>https://irpanblog2.netlify.app/post/materi-pengguna-pembuat-kode/</guid>
      <description>&lt;style&gt;
